# Configuración opcional para el descargador BCR. No incluir valores reales.
BCR_API_BASE_URL=
BCR_API_USER=
BCR_API_PASSWORD=
BCR_API_TOKEN=
BCR_API_USE_AUTH=true
BCR_COMMODITIES_DEFAULT_DAYS_BACK=30

# Configuración opcional para la fuente local mensual. Dejar vacía hasta
# confirmar una URL oficial, estable y autorizada.
LOCAL_MENSUAL_SOURCE_URL=
LOCAL_MENSUAL_SOURCE_NAME=
LOCAL_MENSUAL_RAW_FILENAME=
LOCAL_MENSUAL_HTTP_TIMEOUT=30
LOCAL_MENSUAL_MARKET=
LOCAL_MENSUAL_TIPO_PRECIO=
LOCAL_MENSUAL_CURRENCY=
LOCAL_MENSUAL_UNIT=
LOCAL_MENSUAL_INPUT_FREQUENCY=auto
LOCAL_MENSUAL_AGGREGATE_METHOD=median
